# Radar — environment configuration
# Copy this file to .env and fill in your values.

# Database connection string (required). Two options:
#
#   Local embedded (zero-setup, no external service — PGlite, WASM Postgres):
# DATABASE_URL=file:./radar.db
#
# Local PGlite supports the complete transactional workflow:
DATABASE_URL=file:./radar.db
# Remote Neon HTTP is limited; atomic workflow writes are unsupported.
# See docs/DATABASE_CAPABILITIES.md before choosing it.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional: path to your deal-log markdown directory (used by `radar eval import`)
# DEAL_LOG_DIR=/path/to/deal-log
