{
  "name": "radar",
  "version": "2.4.0-assessment-update.2",
  "description": "Decision infrastructure for private market investors. Portfolio tracking, thesis management, deal pipeline, and bet sizing.",
  "type": "module",
  "license": "MIT",
  "author": "Chandler Koglmeier",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ckoglmeier/radar.git"
  },
  "keywords": [
    "investing",
    "portfolio",
    "angel-investing",
    "private-markets",
    "venture-capital",
    "cli"
  ],
  "bin": {
    "radar": "./src/cli.js"
  },
  "scripts": {
    "test:migration-identity": "node scripts/test-runner.mjs --group migration-identity",
    "radar": "node src/cli.js",
    "test:data-dir": "node scripts/test-runner.mjs --group data-dir",
    "test:backup-restore": "node scripts/test-runner.mjs --group backup-restore",
    "test:identity": "node scripts/test-runner.mjs --group identity",
    "test:canonical-product-model": "node scripts/test-runner.mjs --group canonical-product-model",
    "test:funds-audit": "node scripts/test-runner.mjs --group funds-audit",
    "test:funds": "node scripts/test-runner.mjs --group funds",
    "test:funds-migration": "node scripts/test-runner.mjs --group funds-migration",
    "test:employment-equity-audit": "node scripts/test-runner.mjs --group employment-equity-audit",
    "test:employment-equity": "node scripts/test-runner.mjs --group employment-equity",
    "test:investment-updates": "node scripts/test-runner.mjs --group investment-updates",
    "test:file-vault": "node scripts/test-runner.mjs --group file-vault",
    "test:boundary": "node scripts/test-runner.mjs --group boundary",
    "setup": "node src/cli.js db:setup",
    "import": "node src/cli.js import angellist",
    "test:metrics": "node scripts/test-runner.mjs --group metrics",
    "test:deployment-plan": "node scripts/test-runner.mjs --group deployment-plan",
    "test:returns": "node scripts/test-runner.mjs --group returns",
    "test:lifecycle": "node scripts/test-runner.mjs --group lifecycle",
    "test:commands": "node scripts/test-runner.mjs --group commands",
    "test": "node scripts/test-maintenance.mjs && node scripts/test-runner.mjs",
    "test:local": "node scripts/test-maintenance.mjs && node scripts/test-runner.mjs",
    "test:council-contracts": "node scripts/test-runner.mjs --group council-contracts",
    "eval:council-release": "node src/council/evals/run-release.js",
    "eval:council-controlled-replays": "node src/council/evals/run-controlled-replays.js",
    "setup-hooks": "git config core.hooksPath hooks",
    "test:fast": "node scripts/test-runner.mjs --group fast",
    "test:inventory": "node scripts/test-runner.mjs --list",
    "test:maintenance": "node scripts/test-maintenance.mjs",
    "test:package": "node scripts/test-package.mjs",
    "test:live-assessment": "node --test packages/live-assessment/test/*.test.mjs"
  },
  "engines": {
    "node": ">=20.16.0 <21 || >=22.3.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.204",
    "@electric-sql/pglite": "^0.5.1",
    "@neondatabase/serverless": "^1.0.2",
    "ajv": "8.20.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.4.1",
    "pdf-parse": "^2.4.5"
  },
  "files": [
    "src/",
    "skills/",
    "lenses/_template/",
    "packages/live-assessment/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "pyproject.toml",
    "CONTRIBUTING.md",
    "docs/SETUP.md",
    "docs/COUNCIL_AUTH.md",
    "docs/DATABASE_CAPABILITIES.md",
    "docs/ROADMAP.md",
    "updates/README.md",
    "!src/**/test-*.js",
    "!src/**/test_*.py",
    "!src/**/test-fixtures/**",
    "!packages/**/test/**",
    "!src/**/__pycache__/**",
    "!src/council/evals/results/**",
    "!src/config/bet-sizing.json",
    "!src/config/lead-prefixes.json"
  ]
}
